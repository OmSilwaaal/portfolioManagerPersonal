# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in Supabase → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your_supabase_anon_key_here

# ── Backend API ───────────────────────────────────────────────────────────────
# URL of your deployed Express backend (Railway, Render, etc.)
# With or without a trailing /api — both work
VITE_API_URL=https://your-backend.railway.app

# ── Privy Authentication (Phase 1) ──────────────────────────────────────────
# Privy App ID for Web2 OAuth & Solana Embedded Wallet Creation
VITE_PRIVY_APP_ID=your_privy_app_id_here

# NOTE: every VITE_* variable is bundled into public JavaScript. Only put values here that are safe to expose
# (Supabase URL + ANON key, API URL). Never put service-role keys, Stripe secrets or AI keys in this file.
