# Research: smart-money wallet collector (backend/src/research/wallets)
# Master switch. Collector does nothing unless this is 1.
SMART_MONEY_COLLECTOR=0
# Helius: parsed swap history per wallet (getWalletTrades). https://helius.dev
HELIUS_API_KEY=
# Birdeye: top traders per token (discoverCandidateWallets) + wallet trades fallback. https://birdeye.so
BIRDEYE_API_KEY=
# Existing Tatum gRPC key is stream-only (no historical queries); recognised but not used for discovery.
# TATUM_API_KEY=
# Tuning (optional)
# SMART_MONEY_INTERVAL_MS=900000        # collection cycle (default 15 min)
# SMART_MONEY_MAX_TOKENS=10             # trending tokens per cycle
# SMART_MONEY_MAX_WALLETS=40            # candidate wallets processed per cycle
# SMART_MONEY_LOOKBACK_DAYS=30          # trade history pulled for new wallets

# ---- social (research/social) ----
# Collector is opt-in. Nothing runs unless SOCIAL_COLLECTOR=1.
SOCIAL_COLLECTOR=0
# Per-provider kill switches (set 0 to disable even if keys exist)
SOCIAL_X=1
SOCIAL_TELEGRAM=1

# X data: choose ONE. Official wins if both set.
# Official X API v2: following lists + user timelines need a paid tier (Basic ~ $200/mo at
# last check; verify current pricing). Rate limits are small (following: ~15 req/15min).
X_BEARER_TOKEN=
# twitterapi.io: pay-per-call (roughly $0.15 per 1k tweets / ~$0.15 per 1k followings
# at last check; verify). Free tier ~1 request per 5s. Field mapping is unverified;
# see X_VENDORS in social/providers.js.
TWITTERAPI_IO_KEY=

# Telegram public channels (OPTIONAL). Needs a real Telegram USER session (not a bot), api_id/api_hash
# from my.telegram.org, and `npm i telegram` (gramjs, not a repo dependency). Free, but
# automating a user account risks bans; use a throwaway account. TELEGRAM_SESSION is a
# gramjs StringSession generated once by interactive login.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ---- free social chatter (research/social/feeds.js) ----
# 4chan /biz via the official read-only JSON API (a.4cdn.org). Opt-in. Limits are enforced in code:
# <= 1 request/second, catalog polled ~every 60s, a thread is never refetched within 10s, If-Modified-Since
# on every request, only threads whose last_modified changed are refetched. Posts are anonymous: stored per
# thread (a poster id only if the board provides one), platform='4chan'.
SOCIAL_FOURCHAN=0
# FOURCHAN_BOARD=biz
# SOCIAL_FOURCHAN_INTERVAL_MS=60000     # never below 60000
# FOURCHAN_MAX_THREADS=30               # thread refetches per poll (bounded by the 1 req/s limit)
# FOURCHAN_USER_AGENT=                  # optional override

# Reddit via the official OAuth API (script/web app at reddit.com/prefs/apps). OFF BY DEFAULT: needs all of
# SOCIAL_REDDIT=1, the client id/secret AND REDDIT_NON_COMMERCIAL_ACK=1.
# LICENSING: Reddit's free API tier is NON-COMMERCIAL ONLY. Commercial use REQUIRES Reddit's written approval.
# Do not set the ack in a commercial deployment without it. Rate limit: 100 queries/minute (we stay under).
SOCIAL_REDDIT=0
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_NON_COMMERCIAL_ACK=0
# REDDIT_USERNAME=                      # used in the descriptive User-Agent (by /u/<name>)
# REDDIT_USER_AGENT=                    # or set the whole User-Agent
# REDDIT_SUBREDDITS=solana,CryptoMoonShots,memecoins,SolanaMemeCoins
# SOCIAL_REDDIT_INTERVAL_MS=120000

# Retention: raw post text is kept this many days (social_post_text). Hashes and extracted token candidates
# (social_post_raw) are kept forever. Posts are stored only if they contain a contract address or $TICKER.
# SOCIAL_TEXT_RETENTION_DAYS=30

# ---- winner-first lookback (research/eval/winnerFirst.js) ----
# Do mentions in our stored posts come BEFORE a token's move more often for winners than for matched non-winners?
# Off unless WINNER_FIRST_JOB=1 (see the line to add to index.js in the module header).
WINNER_FIRST_JOB=0
# WINNER_FIRST_INTERVAL_MS=21600000     # every 6h
# WINNER_FIRST_RETURN_PCT=100           # winner = at least +100% ...
# WINNER_FIRST_HORIZON_HOURS=6          # ... within 6h of the reference time
# WINNER_FIRST_REF_AGE_MIN=15           # reference (move start) = first snapshot this long after pool creation
# WINNER_FIRST_SEED=42                  # seeds the matched-control sampling
