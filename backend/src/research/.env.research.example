# Research: smart-money wallet collector (backend/src/research/wallets)
# Master switch. Collector does nothing unless this is 1.
SMART_MONEY_COLLECTOR=0
# Helius: parsed swap history per wallet (getWalletTrades). https://helius.dev
HELIUS_API_KEY=
# Birdeye: top traders per token (discoverCandidateWallets) + wallet trades fallback. https://birdeye.so
BIRDEYE_API_KEY=
# Existing Tatum gRPC key is stream-only (no historical queries); recognised but not used for discovery.
# TATUM_API_KEY=
# Tuning (optional)
# SMART_MONEY_INTERVAL_MS=900000        # collection cycle (default 15 min)
# SMART_MONEY_MAX_TOKENS=10             # trending tokens per cycle
# SMART_MONEY_MAX_WALLETS=40            # candidate wallets processed per cycle
# SMART_MONEY_LOOKBACK_DAYS=30          # trade history pulled for new wallets

# ---- on-chain top-earner wallet discovery (research/wallets/discoverySources.js) ----
# Needs NO social data. Each source is off unless its flag is 1 AND it is configured. Every discovered wallet is only a
# CANDIDATE: whatever PnL a leaderboard reports is stored for audit and IGNORED; the wallet is re-scored from its own
# on-chain trades (Helius/Birdeye) with the holdout rule, using only trades before the scoring time. Only wallets that
# pass the holdout can produce smart_money_event. Candidates and random control wallets get a forward test
# (/research dashboard: "On-chain top-earner wallets"). Candidates are recorded in the append-only wallet_candidate table.
# No scraping of axiom.trade / fomo.family / any site; documented APIs only.
SMART_MONEY_BIRDEYE_LB=0                # Birdeye /trader/gainers-losers + /defi/v2/tokens/top_traders (needs BIRDEYE_API_KEY)
SMART_MONEY_WINNER_BACKBUY=0            # wallets that bought BEFORE the move in tokens the radar flagged as winners (needs ENABLE_RADAR=true)
SMART_MONEY_SEEDS=0                     # manual list: backend/src/research/wallets/wallet_seeds.json (paste from Dune, KolScan, ...; restart after editing)
SMART_MONEY_FOMOAPI=0                   # fomoapi.io leaderboard (needs FOMOAPI_KEY)
SMART_MONEY_SOLANATRACKER=0             # SolanaTracker top traders (needs SOLANATRACKER_API_KEY)
# Birdeye free tier is ~200 requests/day. HARD daily cap on ALL Birdeye calls (wallet trades, top traders, leaderboard,
# back-buyer lookups), persisted in the DB so restarts do not reset it. Over budget = no request is made.
BIRDEYE_DAILY_BUDGET=150
# BIRDEYE_LB_PERIODS=1W                 # comma list for gainers-losers, e.g. 1W,1M (each period/page costs 1 request)
# BIRDEYE_LB_PAGES=1                    # pages of 10 per period (max 5)
# BIRDEYE_LB_TOKENS=2                   # tokens per run to also pull top traders for (0 disables)
FOMOAPI_KEY=
# FOMOAPI_BASE_URL=https://api.fomoapi.io          # field names/paths unverified: edit LEADERBOARD_ADAPTERS in discoverySources.js
# FOMOAPI_LEADERBOARD_PATH=/v1/leaderboard
SOLANATRACKER_API_KEY=
# SOLANATRACKER_BASE_URL=https://data.solanatracker.io
# SOLANATRACKER_LEADERBOARD_PATH=/top-traders/all
# WALLET_SEEDS_PATH=                    # alternative seeds file
# Winner definition for back-buyers (same as the winner-first lookback): >= +100% within 6h of a reference time
# WINNER_BACKBUY_RETURN_PCT=100
# WINNER_BACKBUY_HORIZON_HOURS=6
# WINNER_BACKBUY_REF_AGE_MIN=15         # reference (move start) = first snapshot this long after pool creation
# WINNER_BACKBUY_LOOKBACK_DAYS=14
# WINNER_BACKBUY_MAX_WINNERS=5          # winners processed per run
# WINNER_BACKBUY_MAX_BUYERS=20          # earliest buyers kept per winner
# WINNER_BACKBUY_MIN_FREE_BUYERS=5      # use Helius/Birdeye only if the radar's own trade stream found fewer early buyers
# SMART_MONEY_DISCOVERY_MAX_PER_SOURCE=50
# SMART_MONEY_CONTROLS_PER_CYCLE=10     # random control wallets recorded per cycle (per control source)
# SMART_MONEY_FORWARD_DAYS=7            # forward window for the leaderboard-vs-control persistence test

# ---- social (research/social) ----
# Collector is opt-in. Nothing runs unless SOCIAL_COLLECTOR=1.
SOCIAL_COLLECTOR=0
# Per-provider kill switches (set 0 to disable even if keys exist)
SOCIAL_X=1
SOCIAL_TELEGRAM=1

# X data: choose ONE. Official wins if both set.
# Official X API v2: following lists + user timelines need a paid tier (Basic ~ $200/mo at
# last check; verify current pricing). Rate limits are small (following: ~15 req/15min).
X_BEARER_TOKEN=
# twitterapi.io: pay-per-call (roughly $0.15 per 1k tweets / ~$0.15 per 1k followings
# at last check; verify). Free tier ~1 request per 5s. Field mapping is unverified;
# see X_VENDORS in social/providers.js.
TWITTERAPI_IO_KEY=

# Telegram public channels (OPTIONAL). Needs a real Telegram USER session (not a bot), api_id/api_hash
# from my.telegram.org, and `npm i telegram` (gramjs, not a repo dependency). Free, but
# automating a user account risks bans; use a throwaway account. TELEGRAM_SESSION is a
# gramjs StringSession generated once by interactive login.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ---- free social chatter (research/social/feeds.js) ----
# EXPERIMENTAL "anonymous chatter control" (4chan /biz via the official read-only JSON API, a.4cdn.org). OFF BY DEFAULT.
# 4chan content is UNTRUSTED anonymous input. It needs BOTH flags below (the second one acknowledges that). Guarantees,
# enforced in code and covered by tests:
#   - raw post text is NEVER stored (no social_post_text row, no account_post.text): only a hash plus extracted
#     contract addresses / $cashtags (max 8 of each per post, first 2000 chars examined)
#   - HTML is stripped; images, attachments and links inside posts are never fetched (only catalog.json and
#     thread/<n>.json on the API host are ever requested)
#   - 4chan text is never sent to any LLM and never shown in the web UI (the UI only shows counts and aggregates)
# API limits are enforced: <= 1 request/second, catalog polled ~every 60s, a thread is never refetched within 10s,
# If-Modified-Since on every request, only threads whose last_modified changed are refetched.
SOCIAL_FOURCHAN=0
SOCIAL_FOURCHAN_ACK=0                   # must be 1 as well: "4chan is untrusted anonymous content"
# FOURCHAN_BOARD=biz
# SOCIAL_FOURCHAN_INTERVAL_MS=60000     # never below 60000
# FOURCHAN_MAX_THREADS=30               # thread refetches per poll (bounded by the 1 req/s limit)
# FOURCHAN_USER_AGENT=                  # optional override

# Reddit via the official OAuth API (script/web app at reddit.com/prefs/apps). OFF BY DEFAULT: needs all of
# SOCIAL_REDDIT=1, the client id/secret AND REDDIT_NON_COMMERCIAL_ACK=1.
# LICENSING: Reddit's free API tier is NON-COMMERCIAL ONLY. Commercial use REQUIRES Reddit's written approval.
# Do not set the ack in a commercial deployment without it. Rate limit: 100 queries/minute (we stay under).
SOCIAL_REDDIT=0
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_NON_COMMERCIAL_ACK=0
# REDDIT_USERNAME=                      # used in the descriptive User-Agent (by /u/<name>)
# REDDIT_USER_AGENT=                    # or set the whole User-Agent
# REDDIT_SUBREDDITS=solana,CryptoMoonShots,memecoins,SolanaMemeCoins
# SOCIAL_REDDIT_INTERVAL_MS=120000

# Retention: raw post text (Reddit/X only; never 4chan) is kept this many days (social_post_text). Hashes and extracted
# token candidates (social_post_raw) are kept forever. Posts are stored only if they contain a contract address or $TICKER.
# SOCIAL_TEXT_RETENTION_DAYS=30

# ---- winner-first lookback (research/eval/winnerFirst.js) ----
# Do mentions in our stored posts come BEFORE a token's move more often for winners than for matched non-winners?
# Off unless WINNER_FIRST_JOB=1 (see the line to add to index.js in the module header).
WINNER_FIRST_JOB=0
# WINNER_FIRST_INTERVAL_MS=21600000     # every 6h
# WINNER_FIRST_RETURN_PCT=100           # winner = at least +100% ...
# WINNER_FIRST_HORIZON_HOURS=6          # ... within 6h of the reference time
# WINNER_FIRST_REF_AGE_MIN=15           # reference (move start) = first snapshot this long after pool creation
# WINNER_FIRST_SEED=42                  # seeds the matched-control sampling
