# Radar-only image: collects free memecoin data into a SQLite file on a mounted volume. No web server, no trading.
FROM node:20-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
# better-sqlite3 ships prebuilt binaries for Node 20 on linux x64/arm64, so no compiler is needed
RUN npm ci --omit=dev --no-audit --no-fund
COPY src ./src
ENV NODE_ENV=production \
    RADAR_DB_PATH=/data/radar.sqlite
VOLUME ["/data"]
CMD ["node", "src/radar/run.js"]
