PORT=3001
NODE_ENV=development   # set to "production" on Railway (hides error details, disables wildcard CORS, blocks dev-only paths)
# Extra allowed browser origins, comma-separated (e.g. a Vercel preview domain). FRONTEND_URL is always allowed.
CORS_EXTRA_ORIGINS=

# ── Encryption at rest ────────────────────────────────────────────────────────
# 32-byte key (64 hex chars) used to encrypt brokerage (SnapTrade) secrets in SQLite.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in Supabase → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Frontend URLs (used in Stripe redirect URLs) ──────────────────────────────
FRONTEND_URL=https://travauxus.com
FRONTEND_URL_WWW=https://www.travauxus.com

# ── Stripe ────────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRO_PRICE_ID=price_...

# Two separate webhook secrets — register two endpoints in Stripe Dashboard:
#   1. /api/stripe/pro-webhook      → paste secret as STRIPE_WEBHOOK_SECRET
#   2. /api/paper-trading/webhook   → paste secret as STRIPE_WEBHOOK_SECRET
STRIPE_PRO_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Promo code — RETIRED, grants nothing ──────────────────────────────────────
# This used to be a single shared string that set app_metadata.isPro = true permanently for
# anyone who knew it. No shared password is "unhackable": it is unattributable, cannot be
# revoked for one person, and leaves no audit trail — unacceptable once real money is in the
# system. /api/stripe/redeem-code now returns 410 whatever this is set to.
# Comp an account instead via POST /api/billing/admin/pro (see BILLING_ADMIN_USER_IDS below).
PROMO_CODE=

# ── Market data APIs ──────────────────────────────────────────────────────────
FINNHUB_API_KEY=your_finnhub_key_here
MARKETAUX_API_KEY=your_marketaux_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ── Account recovery phrases ──────────────────────────────────────────────────
# Secret used to hash recovery phrases (falls back to DATA_ENCRYPTION_KEY). Keep it stable — rotating it invalidates every phrase.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECOVERY_PEPPER=

# ── SMS alerts (Twilio) ───────────────────────────────────────────────────────
# Console → Verify → Services → create one; paste its SID. Text alerts stay hidden until all of these are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Sender for alert texts — set ONE of these
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── SnapTrade (brokerage connector — free tier) ───────────────────────────────
# Sign up at https://snaptrade.com → Dashboard → API credentials
SNAPTRADE_CLIENT_ID=your_snaptrade_client_id
SNAPTRADE_CONSUMER_KEY=your_snaptrade_consumer_key

# ── High-Speed Solana Trading Pipeline (Axiom Add-on) — EXPERIMENTAL ──────────
# Disabled unless set to true. The code is a mock (random triggers, throwaway keypairs).
ENABLE_SOLANA_PIPELINE=false
# 1. Tatum Yellowstone gRPC API Key (Header x-token)
TATUM_API_KEY=your_tatum_api_key_here

# 2. Helius RPC / Sender API Key (Mempool Bypass)
HELIUS_API_KEY=your_helius_api_key_here

# 3. Upstash Serverless Redis Connection URL / Token
UPSTASH_REDIS_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_token_here

# ── Live memecoin stream (SSE at /api/memecoins/stream) ──────────────────────
# New pump.fun launches pushed into the stream via Helius. Needs HELIUS_API_KEY
# above; off unless this is true, and the server runs normally without it.
ENABLE_HELIUS_LAUNCHES=false
# How often to ask Helius for new launches. Floor is 2000.
# HELIUS_LAUNCH_POLL_MS=6000

# Sub-second prices for the tokens the stream is watching, read straight off the pump.fun
# bonding curve over a Helius WebSocket instead of waiting 10-30s for an aggregator to index
# the swap. On whenever HELIUS_API_KEY is set — set this to false to turn it off. Without a key
# it is inert and the stream behaves exactly as it does today.
# ENABLE_HELIUS_PRICE=false

# Memecoin alerts sweep. On by default, because each user opts in individually
# inside the app and the sweep returns immediately when nobody has. It used to
# require a variable that was never set anywhere, which is why the bell stayed
# empty no matter how it was configured.
# ENABLE_MEMECOIN_ALERTS=false

# ── CoinGecko key for the GeckoTerminal endpoints (optional, strongly recommended) ──
# Unset, the keyless tier is used and measures ~6-8 calls/min from one IP against a published 30,
# which is the hard ceiling on how many charts and lists the terminal can load. A free Demo key
# makes the 30/min real and per-key rather than per-IP, and the deep-page prefetch is allowed a
# larger share automatically when one is present. Same endpoints, served under /onchain.
# Get one at https://www.coingecko.com/en/developers/dashboard
# COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxxxxxx
# COINGECKO_PLAN=demo   # or "pro" for a paid key (different host AND header)

# ══════════════════════════════════════════════════════════════════════════════
# BILLING — deposits, Pro, and the 5% fee
#
# Everything below is OPT-IN. With none of it set the server boots and behaves exactly as it
# did before billing existed: the routes mount, every paying endpoint answers 503, and the UI
# is told the rails are off so it renders no way to pay. Each rail needs BOTH its flag AND
# its keys, so a stray key cannot switch a rail on by itself.
# ══════════════════════════════════════════════════════════════════════════════

# ── Card rail (Stripe) ────────────────────────────────────────────────────────
# Off unless this is exactly "true" AND the three keys below are all present.
ENABLE_BILLING_STRIPE=false

# Dashboard → Developers → API keys. The SECRET key stays on the server and is never returned
# by any endpoint, logged, or put in an error message. STRIPE_SECRET_KEY is shared with the
# older /api/stripe routes, so it may already be set above.
# STRIPE_SECRET_KEY=sk_live_...

# The PUBLISHABLE key is the only Stripe key that may reach a browser. It is served to the
# client by GET /api/billing/config.
BILLING_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Dashboard → Developers → Webhooks → add an endpoint for  POST /api/billing/webhook
# Subscribe it to: checkout.session.completed, customer.subscription.deleted
# (charge.refunded and charge.dispute.created are logged for manual review if you add them).
# Paste that endpoint's signing secret here. This is a THIRD webhook secret, separate from
# STRIPE_PRO_WEBHOOK_SECRET and STRIPE_WEBHOOK_SECRET above — each endpoint has its own.
BILLING_STRIPE_WEBHOOK_SECRET=whsec_...

# A recurring Price object id for Pro (Dashboard → Products). Only the ID crosses the wire;
# the amount is Stripe's, never the client's.
BILLING_STRIPE_PRO_PRICE_ID=price_...

# ── SOL rail ──────────────────────────────────────────────────────────────────
# Off unless this is exactly "true" AND a valid treasury address is set.
ENABLE_BILLING_SOLANA=false

# The PUBLIC Solana address that receives deposits and Pro payments. Public by necessity —
# users send to it. Its PRIVATE KEY MUST NOT BE PUT ANYWHERE NEAR THIS SERVER: nothing here
# sweeps, signs or spends, and there is no config slot or database column for key material.
# Hold it in a hardware or multisig wallet you control.
BILLING_TREASURY_ADDRESS=

# RPC used only to READ transactions back for verification. A public endpoint works but is
# rate-limited; a Helius/QuickNode URL is better. If the URL embeds a key, note it is read
# here only and never returned to a client.
BILLING_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Price of one month of Pro, in LAMPORTS (1 SOL = 1_000_000_000). Deliberately a fixed
# operator-set figure rather than a USD price converted at request time: charging real money
# through a price oracle lets a stale or manipulated quote set the price. Leave blank to
# disable paying for Pro in SOL while still accepting SOL deposits.
BILLING_PRO_PRICE_LAMPORTS=

# ── Admin (no shared password) ────────────────────────────────────────────────
# Comma-separated Supabase USER IDs (UUIDs) that bootstrap the admin role. This is an
# IDENTIFIER, not a credential: knowing it gains nothing, because you still have to hold a
# valid session for that account. Leaking it is embarrassing, not exploitable — which is the
# whole difference from the retired PROMO_CODE above.
# Those accounts can then grant/revoke Pro via POST /api/billing/admin/pro (reason required,
# max 366 days, every action written to admin_audit) and promote others via /admin/role.
# With this unset and no user_roles row, nobody is an admin and no Pro can be comped.
BILLING_ADMIN_USER_IDS=
