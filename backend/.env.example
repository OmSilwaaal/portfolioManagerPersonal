FINNHUB_API_KEY=your_finnhub_key_here
MARKETAUX_API_KEY=your_marketaux_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
PORT=3001

# REQUIRED: Supabase project credentials (find in Supabase → Settings → API)
# SUPABASE_URL is your project URL, SUPABASE_ANON_KEY is the "anon public" key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# REQUIRED in production: set to your Railway frontend URL
FRONTEND_URL=http://localhost:5173

# REQUIRED in production: suppresses stack traces in error responses
NODE_ENV=development

# Optional: promo code for granting Pro access without payment
# Keep this secret — it is validated server-side only, never sent to the client
PROMO_CODE=your_promo_code_here

# SnapTrade brokerage connector (https://snaptrade.com — free tier up to 100 users)
# Get these from the SnapTrade dashboard after signing up
SNAPTRADE_CLIENT_ID=your_snaptrade_client_id
SNAPTRADE_CONSUMER_KEY=your_snaptrade_consumer_key
