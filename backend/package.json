{
  "name": "market-intelligence-backend",
  "version": "1.0.0",
  "description": "Market Intelligence App Backend API",
  "main": "src/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "pretest": "rm -f \"${TMPDIR:-/tmp}\"/travauxus-test-*.sqlite*",
    "test": "DB_PATH=\"${TMPDIR:-/tmp}/travauxus-test-$$.sqlite\" node --test test/*.test.js",
    "postinstall": "rm -rf node_modules/rpc-websockets/node_modules/uuid || true",
    "db:check": "node scripts/db-check.js",
    "db:space": "node scripts/db-space.js",
    "db:migrate": "node scripts/db-check.js --migrate",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "db:backups": "node scripts/db-restore.js --list",
    "db:restore-social": "node scripts/restore-social.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@solana/web3.js": "^1.99.0",
    "@supabase/supabase-js": "^2.106.0",
    "@triton-one/yellowstone-grpc": "^8.0.0",
    "@upstash/redis": "^1.39.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.2.0",
    "node-cache": "^5.1.2",
    "rss-parser": "^3.13.0",
    "snaptrade-typescript-sdk": "^10.0.2",
    "stripe": "^22.1.1",
    "uuid": "9.0.1",
    "ws": "^8.18.0"
  },
  "overrides": {
    "uuid": "9.0.1",
    "rpc-websockets": {
      "uuid": "9.0.1"
    }
  }
}
